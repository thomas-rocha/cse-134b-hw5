---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About | Thomas Rocha">
      <article id="about-me">
        <h1>About me</h1>
        <p>
          I am a 4th year computer science student at <i>UC San Diego</i>. I enjoy 
          building web applications and learning new technologies. I have experience 
          with <b>front-end</b> and <b>back-end</b> development, and data analysis.
          <br />
          I like to work on projects that challenge me and allow me to learn new skills. 
          I am always looking for opportunities to grow as a developer and contribute to 
          meaningful projects.
          <br />
          In my free time, I enjoy playing video games, reading, and spending time with
          friends and family. I love traveling and exploring new places, and I am always looking for new adventures.
        </p>
      </article>
      <section id="carousel">
        <h2>My life</h2>
        <div class="carousel">
          <div class="carousel-container">
            <img src="images/image.png" alt="My workspace" />
            <img src="images/image.png" alt="Life outside code, photo 1" />
            <img src="images/image.png" alt="Life outside code, photo 2" />
          </div>
          <div class="carousel-input">
            <button type="button" class="small-button">Previous</button>
            <span>1</span>
            <span>2</span>
            <span>3</span>
            <button type="button" class="small-button">Next</button>
          </div>
        </div>
      </section>

      <section id="location">
        <h2>Where I'm based</h2>
        <iframe
          src="https://www.google.com/maps?q=UC+San+Diego&amp;output=embed"
          title="Map of UC San Diego"
          loading="lazy"
          width="50%"
        ></iframe>
      </section>
    
</BaseLayout>
